# Copy this file to .env (in the repo root). LEETCODE_SESSION / LEETCODE_CSRFTOKEN
# are normally filled in automatically the first time you click "Connect LeetCode"
# in the app (a real browser window opens for you to log in — see README). Only
# set these by hand if that flow doesn't work for you: DevTools -> Application ->
# Cookies -> https://leetcode.com, copy LEETCODE_SESSION and csrftoken.
# This is YOUR session, used only to read YOUR OWN accepted submissions.
# Never share this value or commit the real .env file.

LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=

# Optional. Only needed for "Import from LeetCode" -> Generate AI solution,
# and the Random-problem generator. Without it, imported public problems are
# created with blank code for you to fill in yourself. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

PORT=5174

# Optional. Raises the GitHub API rate limit for "Sync Companies" from
# 60/hour (unauthenticated, shared per-IP — easy to exhaust on a hosted
# deploy) to 5000/hour. A fine-grained token with no scopes (public repo
# read) is enough: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

{
  "name": "leetcode-flashcards",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "sync": "npm run sync -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "@google/genai@2.18.0": true,
    "protobufjs@7.6.5": true
  }
}
